# Define all coms in DAG streaming.
    module_config {
    module_library : "/apollo/bazel-bin/cyber/examples/common_component_example/libcommon_component_example.so"
    components {
        class_name : "CommonComponentSample"
        config {
            name : "common"
            readers {
                channel: "/apollo/test"
            }
        }
      }
    components {
        class_name : "CommonPredictionComponentSample"
        config {
            name : "commonprediction"
            readers {
                channel: "/apollo/prediction"
            }
        }
    }
    components {
        class_name : "CommonPerceptionComponentSample"
        config {
            name : "commonperception"
            readers {
                channel: "/apollo/perception/obstacles"
            }
        }
    }
}
